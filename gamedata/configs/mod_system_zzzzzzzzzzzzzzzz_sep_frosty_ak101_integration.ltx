aim_hud_offset_rot                  = 0.042933, 0.019842, 0.009113
aim_hud_offset_rot_16x9             = 0.042933, 0.019842, 0.009113

attach_base_hud_offset_pos          = -0.083176, 0.117313, -0.202476
attach_base_hud_offset_pos_16x9     = -0.083176, 0.117313, -0.202476
attach_base_hud_offset_rot          = -0.009168, -0.011379, -0.006103
